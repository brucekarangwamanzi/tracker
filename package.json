{
  "name": "bruces-life",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "npm start",
    "start": "npm run mobile:build && node scripts/serve-mobile.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "schema:generate": "node --import tsx scripts/generate-schema.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "check": "npm run schema:generate && npm run db:generate && npm run typecheck && npm test",
    "api:start": "node --env-file=.env --import tsx src/server/main.ts",
    "api:dev": "node --env-file=.env --import tsx --watch src/server/main.ts",
    "mobile": "npm --prefix apps/mobile start",
    "mobile:check": "npm --prefix apps/mobile run typecheck && npm --prefix apps/mobile run lint",
    "mobile:build": "npm --prefix apps/mobile run export",
    "mobile:test": "npm --prefix apps/mobile test",
    "mobile:serve": "node scripts/serve-mobile.mjs"
  },
  "dependencies": {
    "@fastify/cors": "11.3.1",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "10.3.0",
    "@js-temporal/polyfill": "0.5.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "fastify": "5.12.7",
    "jose": "6.2.12",
    "node-cron": "4.6.0",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/sql.js": "1.4.11",
    "prisma": "7.10.1",
    "sql.js": "1.15.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
